nextflow_process {

    name "Test Process MOSDEPTH_REGIONS_TO_MQC"
    script "../main.nf"
    process "MOSDEPTH_REGIONS_TO_MQC"

    tag "modules"
    tag "modules_local"
    tag "mosdepth_regions_to_mqc"

    test("mosdepth_regions_to_mqc - bed - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr22_chr22_KI270734v1_random/sequence/genome.fa.gz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
